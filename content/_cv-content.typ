// All publications, newest first, regardless of role; the role filter
// on the Publication page hides/shows entries within this single list.
#let all-publications-data = (first-authored-data + collaborative-data).sorted(key: e => -e.year)

// Render a data array as expandable HTML <li><details> entries: the
// citation is always visible in <summary>; a note (media coverage,
// cover story, equal-contribution flag, etc.) expands on click. Each
// entry carries a `data-role` attribute (used by the Role filter, not
// shown inline).
#let render-pub-list-html(entries) = html.elem("ul", {
  for e in entries {
    let citation = [#e.cite #e.meta]
    let li-attrs = (class: "pub-role-" + e.role, "data-role": e.role)
    if "note" in e {
      html.elem("li", attrs: li-attrs, html.elem("details", {
        html.elem("summary", citation)
        html.elem("span", attrs: (class: "pub-note"), e.note)
      }))
    } else {
      html.elem("li", attrs: li-attrs, citation)
    }
  }
